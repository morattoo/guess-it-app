rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==============================================================
    // ACCESO BLOQUEADO AL FRONTEND
    // ==============================================================
    // Todas las operaciones DEBEN pasar por Cloud Functions
    // El frontend NO tiene acceso directo a Firestore
    // Solo las Cloud Functions (con Admin SDK) pueden leer/escribir
    // ==============================================================

    // Denegar TODO acceso directo desde el cliente
    match /{document=**} {
      allow read, write: if false;
    }

    // ==============================================================
    // EXCEPCIÓN: Coleción pública de metadata de sesión.
    // Solo contiene { status, isOpen } — sin preguntas ni respuestas.
    // Permite escuchar cambios de status en tiempo real desde el cliente.
    // Requiere autenticación (incluso anónima — el join flow ya la crea).
    // ==============================================================
    match /gameSessionsMeta/{gameSessionId} {
      allow read: if request.auth != null;
    }

    // Nota: Las Cloud Functions usan el Admin SDK que bypasea
    // estas reglas de seguridad, por lo que pueden acceder sin problemas
  }
}
